{
  "name": "ps5-agentic-ui",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node --test runtime/*.test.ts channel/*.test.ts",
    "test:runtime": "node --test runtime/*.test.ts",
    "test:channel": "node --test channel/*.test.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p channel/tsconfig.json",
    "build": "pnpm -r --filter './runtime' --filter './channel' run build",
    "build:agent-js": "esbuild server/embedded.ts --bundle --format=iife --platform=neutral --target=es2023 --main-fields=module,main --alias:node:crypto=./server/qjs/node-crypto.ts --outfile=server/qjs/agent.js",
    "agent": "node server/index.ts",
    "channel": "node channel/example.ts",
    "pair": "node scripts/ps5-pair.ts",
    "eval:catalog": "node --env-file-if-exists=.env eval/catalog-eval/run.ts"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.2",
    "@copilotkit/channels-core": "0.12.0",
    "@copilotkit/core": "1.85.0",
    "@copilotkit/runtime": "1.85.0",
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2"
  },
  "version": "1.0.0",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.9.1"
}
