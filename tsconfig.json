{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "strict": false
  },
  "include": [
    "runtime/**/*.ts",
    "server/**/*.ts",
    "eval/**/*.ts",
    "scripts/**/*.ts",
    "renderer/fixtures/*.ts"
  ]
}
