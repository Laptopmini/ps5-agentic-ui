{
  "name": "copilotkit-channels-ps5",
  "version": "1.0.0",
  "description": "A CopilotKit Channels PlatformAdapter that turns a PlayStation 5 into an agent surface: native A2UI screens, the DualSense, haptics and the system keyboard.",
  "license": "MIT",
  "author": "Laptopmini <laptopmini@gmail.com>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/channel/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/channel/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "esbuild index.ts --bundle --format=esm --platform=node --packages=external --outfile=dist/index.js && tsc -p tsconfig.json && node ../scripts/fix-dts.mjs dist",
    "prepublishOnly": "pnpm run build",
    "test": "node --test *.test.ts"
  },
  "peerDependencies": {
    "@copilotkit/channels-core": "^0.12.0"
  },
  "devDependencies": {
    "@copilotkit/channels-core": "0.12.0",
    "@types/node": "^26.6.6",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "copilotkit",
    "channels",
    "ag-ui",
    "a2ui",
    "ps5",
    "playstation",
    "agent",
    "adapter",
    "generative-ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Laptopmini/ps5-agentic-ui.git",
    "directory": "channel"
  },
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/Laptopmini/ps5-agentic-ui/tree/main/channel#readme",
  "bugs": "https://github.com/Laptopmini/ps5-agentic-ui/issues"
}
